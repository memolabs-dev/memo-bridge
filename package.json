{
  "name": "memo-bridge",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Memo Labs MCP: read-only Mac and VPS observation, project catalogue, coordination of AI work sessions on GitHub Issues, and a Mac runner (worktrees, test/build/lint jobs, pull requests)",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "esbuild server/index.mjs server/runners/job-runner.mjs --bundle --platform=node --format=esm --target=node22 --outdir=plugin/server/dist --entry-names=[name] --out-extension:.js=.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tests/mcp-smoke.mjs",
    "package:plugin": "npm run build && node scripts/package-plugin.mjs",
    "test:hub": "node --test tests/hub-auth.test.mjs",
    "start:hub": "node bridge/hub-cli.mjs",
    "start:agent": "node bridge/agent-cli.mjs",
    "install:local": "npm run build && node scripts/install-local.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "jose": "^6.2.12",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.0"
  }
}

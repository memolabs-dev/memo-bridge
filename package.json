{
  "name": "memo-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Memo Labs MCP: read-only Mac and VPS observation, project catalogue, and a private Coordinator for parallel AI work sessions",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "esbuild server/index.mjs --bundle --platform=node --format=esm --target=node22 --outfile=plugin/server/dist/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tests/mcp-smoke.mjs",
    "package:plugin": "npm run build && node scripts/package-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "esbuild": "^0.25.0"
  }
}

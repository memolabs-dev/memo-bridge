{
  "name": "memo-bridge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Memo Labs MCP: read-only Mac and VPS observation, project catalogue, and coordination of AI work sessions on GitHub Issues",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "esbuild server/index.mjs --bundle --platform=node --format=esm --target=node22 --outfile=plugin/server/dist/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tests/mcp-smoke.mjs",
    "package:plugin": "npm run build && node scripts/package-plugin.mjs",
    "test:hub": "node --test tests/hub-auth.test.mjs",
    "start:hub": "node bridge/hub-cli.mjs",
    "start:agent": "node bridge/agent-cli.mjs",
    "install:local": "npm run build && node scripts/install-local.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "jose": "^6.2.12",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.0"
  }
}

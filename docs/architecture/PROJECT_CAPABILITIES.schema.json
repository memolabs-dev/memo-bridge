{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memo Labs verified project capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "purpose",
    "capabilities",
    "evidence",
    "verified_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "status",
          "source_ref"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "partial",
              "unknown",
              "retired"
            ]
          },
          "source_ref": {
            "type": "string"
          },
          "test_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "overlaps_with": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "const": "repository"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "upstream_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
